{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npx playwright test:*)",
      "Bash(python3 scripts/verify/run.py:*)",
      "Bash(python3 .claude/hooks/dependency_gate.py:*)",
      "Bash(docker compose ps)",
      "Bash(python3 .claude/hooks/version_status.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./data/**)",
      "Edit(.claude/hooks/**)",
      "Edit(.claude/settings.json)",
      "Edit(scripts/verify/run.py)",
      "Edit(docs/VERIFICATION.md)",
      "Edit(docs/verification-logs/**)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm -rf:*)",
      "Edit(.claude/version_seen)",
      "Edit(docs/version_state.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/dependency_gate.py\" --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/tracking_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/version_status.py\" --brief"
          }
        ]
      }
    ]
  }
}
